{
    "manifest_version": 3,
    "name": "TRACK CN DOUBT PAGE",
    "version": "1.0",
    "permissions": ["activeTab", "offscreen"],
    "host_permissions": ["https://mentor.codingninjas.com/doubts/workplace"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://mentor.codingninjas.com/doubts/workplace"],
            "js":["content.js"]
        }
    ],
    "web_accessible_resources": [
        {
        "resources": ["alert.mp3", "ding.mp3"],
        "matches": ["<all_urls>"]
        }
  ]
}